// Generated by matugen — keep values in sync with the Noctalia "Oleo" palette.
// Contains the whole layout block plus the recent-windows highlight.

layout {
    gaps 14
    background-color "transparent"

    focus-ring {
        width 6
        active-color "#5b4426"
        inactive-color "#5c4a30aa"
    }

    shadow {
        softness 18
        spread 2
        offset x=0 y=3
    }
}

// Recent-Windows-Switcher (Super+Tab): Markierung wie der normale Focus-Ring.
recent-windows {
    open-delay-ms 250
    highlight {
        active-color "#5b4426e6"
        urgent-color "#a4433aee"
        padding 6
        corner-radius 12
    }
    previews {
        max-height 260
        max-scale 0.3
    }
}
